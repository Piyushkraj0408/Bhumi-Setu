# Required
MISTRAL_API_KEY=your_mistral_api_key_here

# Current Mistral OCR alias
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Confidence detail: page, block, or word
MISTRAL_CONFIDENCE_GRANULARITY=block

# Keep paragraph/layout blocks in the response
MISTRAL_INCLUDE_BLOCKS=true

# Optional table rendering: markdown or html
MISTRAL_TABLE_FORMAT=markdown

# Extract header/footer separately
MISTRAL_EXTRACT_HEADER=false
MISTRAL_EXTRACT_FOOTER=false

# API timeout in seconds
MISTRAL_TIMEOUT_SECONDS=180

# Final field review threshold
REVIEW_THRESHOLD=0.70
